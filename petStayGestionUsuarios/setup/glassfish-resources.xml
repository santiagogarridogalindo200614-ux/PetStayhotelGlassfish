<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE resources PUBLIC "-//GlassFish.org//DTD GlassFish Application Server 3.1 Resource Definitions//EN" "http://glassfish.org/dtds/glassfish-resources_1_5.dtd">
<!--
  Recursos que NetBeans crea automaticamente en GlassFish al ejecutar el proyecto (Run).
  Ruta en el proyecto: petStayGestionUsuarios/setup/glassfish-resources.xml
-->
<resources>

    <!-- POOL DE CONEXIONES a MySQL (base de datos petstayhotel) -->
    <jdbc-connection-pool name="petstayPool"
                          res-type="javax.sql.DataSource"
                          datasource-classname="com.mysql.cj.jdbc.MysqlDataSource">
        <property name="serverName" value="localhost"/>
        <property name="portNumber" value="3306"/>
        <property name="databaseName" value="petstayhotel"/>
        <property name="user" value="petstay"/>
        <property name="password" value="petstay123"/>
        <property name="useSSL" value="false"/>
        <property name="allowPublicKeyRetrieval" value="true"/>
        <property name="serverTimezone" value="UTC"/>
    </jdbc-connection-pool>

    <!-- RECURSO JDBC: es el nombre que usa persistence.xml (jta-data-source) -->
    <jdbc-resource enabled="true" jndi-name="jndi/jdbc" object-type="user" pool-name="petstayPool"/>

</resources>
